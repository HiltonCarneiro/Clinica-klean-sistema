<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.clinica.controller.CaixaController"
            styleClass="page-root"
            stylesheets="@/styles/app.css">

    <top>
        <VBox spacing="16" styleClass="top-clean">
            <padding>
                <Insets top="22" right="28" bottom="18" left="28"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="5">
                    <Label text="Caixa / Faturamento" styleClass="page-title"/>
                    <Label text="Lance produtos, procedimentos e finalize notas com geração de recibo em PDF."
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="4">
                    <Label text="Área financeira" styleClass="dashboard-badge-admin"/>
                    <Label text="Acesso restrito" styleClass="label-muted"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="22">
            <padding>
                <Insets top="0" right="28" bottom="28" left="28"/>
            </padding>

            <ScrollPane fitToWidth="true"
                        prefWidth="460"
                        styleClass="page-scroll">

                <content>
                    <VBox spacing="18" styleClass="dashboard-panel">
                        <padding>
                            <Insets top="22" right="22" bottom="22" left="22"/>
                        </padding>

                        <VBox spacing="6">
                            <Label text="Dados da nota" styleClass="section-title"/>
                            <Label text="Selecione o paciente, profissional e forma de pagamento."
                                   wrapText="true"
                                   styleClass="hint-text"/>
                        </VBox>

                        <Separator/>

                        <VBox spacing="8">
                            <Label text="Paciente" styleClass="form-label"/>
                            <ComboBox fx:id="cbPaciente"
                                      editable="true"
                                      maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Profissional" styleClass="form-label"/>
                            <ComboBox fx:id="cbProfissional"
                                      editable="true"
                                      maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Forma de pagamento" styleClass="form-label"/>
                            <ComboBox fx:id="cbFormaPagamento"
                                      maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Observação da nota" styleClass="form-label"/>
                            <TextArea fx:id="txtObservacao"
                                      prefRowCount="3"
                                      wrapText="true"
                                      promptText="Observações administrativas ou financeiras..."
                                      styleClass="area-clean"/>
                        </VBox>

                        <VBox spacing="12" styleClass="box-soft">
                            <Label text="Adicionar item" styleClass="section-title"/>

                            <HBox spacing="16">
                                <RadioButton fx:id="rbProduto" text="Produto"/>
                                <RadioButton fx:id="rbProcedimento" text="Procedimento"/>
                            </HBox>

                            <VBox spacing="8">
                                <Label text="Produto" styleClass="form-label"/>
                                <ComboBox fx:id="cbProduto"
                                          editable="true"
                                          maxWidth="1.7976931348623157E308"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Descrição do procedimento" styleClass="form-label"/>
                                <TextField fx:id="txtDescricaoProcedimento"
                                           promptText="Ex: Consulta, retorno, sessão..."/>
                            </VBox>

                            <HBox spacing="12">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Quantidade" styleClass="form-label"/>
                                    <TextField fx:id="txtQuantidade"
                                               promptText="1"/>
                                </VBox>

                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Valor unitário" styleClass="form-label"/>
                                    <TextField fx:id="txtValorUnitario"
                                               promptText="R$ 0,00"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="12">
                                <Button fx:id="btnAdicionarItem"
                                        text="Adicionar item"
                                        onAction="#onAdicionarItem"
                                        maxWidth="1.7976931348623157E308"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="btn-primary"/>

                                <Button fx:id="btnRemoverItem"
                                        text="Remover"
                                        onAction="#onRemoverItem"
                                        maxWidth="1.7976931348623157E308"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="btn-ghost"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>

            <VBox spacing="18"
                  HBox.hgrow="ALWAYS"
                  styleClass="dashboard-panel">
                <padding>
                    <Insets top="22" right="22" bottom="22" left="22"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4">
                        <Label text="Itens da nota" styleClass="section-title"/>
                        <Label text="Confira os produtos e procedimentos antes de finalizar."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox alignment="CENTER_RIGHT" spacing="4">
                        <Label text="Total da nota" styleClass="total-label"/>
                        <Label fx:id="lblTotal" text="R$ 0,00" styleClass="finance-total-value"/>
                    </VBox>
                </HBox>

                <TableView fx:id="tblItens"
                           VBox.vgrow="ALWAYS"
                           styleClass="table-soft">
                    <columns>
                        <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="320"/>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="130"/>
                        <TableColumn fx:id="colQuantidade" text="Qtd." prefWidth="100"/>
                        <TableColumn fx:id="colValorUnitario" text="Valor unit." prefWidth="140"/>
                        <TableColumn fx:id="colValorTotal" text="Total" prefWidth="140"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="A nota será salva e o recibo poderá ser gerado em PDF."
                           styleClass="hint-text"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnFechar"
                            text="Fechar"
                            onAction="#onFechar"
                            styleClass="btn-ghost"/>

                    <Button fx:id="btnFinalizar"
                            text="Finalizar nota"
                            onAction="#onFinalizarNota"
                            styleClass="btn-primary"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>