<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.clinica.controller.AgendaController"
            styleClass="page-root"
            stylesheets="@/styles/app.css">

    <top>
        <VBox spacing="18"
              styleClass="top-clean">

            <padding>
                <Insets top="22"
                        right="28"
                        bottom="20"
                        left="28"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="16">

                <VBox spacing="5">
                    <Label text="Agenda Clínica"
                           styleClass="page-title"/>

                    <Label text="Gerencie consultas, atendimentos e organização clínica diária."
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT"
                      spacing="4">

                    <Label text="Fluxo clínico"
                           styleClass="dashboard-badge"/>

                    <Label text="Agenda operacional"
                           styleClass="label-muted"/>
                </VBox>
            </HBox>

            <HBox spacing="18">

                <VBox spacing="8"
                      styleClass="metric-card">

                    <Label text="Consultas"
                           styleClass="metric-title"/>

                    <Label text="Agenda do dia"
                           styleClass="metric-value"/>

                    <Label text="Visualize atendimentos programados."
                           wrapText="true"
                           styleClass="metric-desc"/>
                </VBox>

                <VBox spacing="8"
                      styleClass="metric-card">

                    <Label text="Profissionais"
                           styleClass="metric-title"/>

                    <Label text="Organização"
                           styleClass="metric-value"/>

                    <Label text="Controle salas e horários disponíveis."
                           wrapText="true"
                           styleClass="metric-desc"/>
                </VBox>

                <VBox spacing="8"
                      styleClass="metric-card metric-card-admin">

                    <Label text="Atendimento"
                           styleClass="metric-title"/>

                    <Label text="Fluxo clínico"
                           styleClass="metric-value"/>

                    <Label text="Inicie e finalize consultas rapidamente."
                           wrapText="true"
                           styleClass="metric-desc"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="22">

            <padding>
                <Insets top="0"
                        right="28"
                        bottom="28"
                        left="28"/>
            </padding>

            <ScrollPane fitToWidth="true"
                        prefWidth="430"
                        styleClass="page-scroll">

                <content>
                    <VBox spacing="18"
                          styleClass="dashboard-panel">

                        <padding>
                            <Insets top="22"
                                    right="22"
                                    bottom="22"
                                    left="22"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT">

                            <Label text="Novo Agendamento"
                                   styleClass="section-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="Novo"
                                    onAction="#onNovo"
                                    styleClass="btn-ghost"/>
                        </HBox>

                        <Separator/>

                        <VBox spacing="8">
                            <Label text="Data"
                                   styleClass="form-label"/>

                            <DatePicker fx:id="dpData"
                                        onAction="#onDataAlterada"
                                        maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <HBox spacing="12">

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Hora início"
                                       styleClass="form-label"/>

                                <TextField fx:id="txtHoraInicio"
                                           promptText="08:00"/>
                            </VBox>

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Hora fim"
                                       styleClass="form-label"/>

                                <TextField fx:id="txtHoraFim"
                                           promptText="09:00"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="8">
                            <Label text="Profissional"
                                   styleClass="form-label"/>

                            <ComboBox fx:id="cbProfissional"
                                      maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Paciente"
                                   styleClass="form-label"/>

                            <ComboBox fx:id="cbPaciente"
                                      editable="true"
                                      maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Sala"
                                   styleClass="form-label"/>

                            <ComboBox fx:id="cbSala"
                                      maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Procedimento"
                                   styleClass="form-label"/>

                            <TextField fx:id="txtProcedimento"
                                       promptText="Ex: Consulta, retorno, avaliação..."/>
                        </VBox>

                        <VBox spacing="8"
                              VBox.vgrow="ALWAYS">

                            <Label text="Observações"
                                   styleClass="form-label"/>

                            <TextArea fx:id="txtObservacoes"
                                      prefRowCount="5"
                                      wrapText="true"
                                      VBox.vgrow="ALWAYS"
                                      promptText="Observações clínicas ou administrativas..."/>
                        </VBox>

                        <!-- BOTÕES DO FORMULÁRIO -->

                        <HBox spacing="12">

                            <Button text="💾 Salvar Agendamento"
                                    onAction="#onSalvar"
                                    maxWidth="1.7976931348623157E308"
                                    HBox.hgrow="ALWAYS"
                                    styleClass="btn-primary"/>

                            <Button text="✎ Limpar"
                                    onAction="#onNovo"
                                    maxWidth="1.7976931348623157E308"
                                    HBox.hgrow="ALWAYS"
                                    styleClass="btn-ghost"/>
                        </HBox>

                        <Label fx:id="lblMensagem"
                               wrapText="true"
                               styleClass="hint-text"/>

                    </VBox>
                </content>
            </ScrollPane>

            <VBox spacing="16"
                  HBox.hgrow="ALWAYS"
                  styleClass="dashboard-panel">

                <padding>
                    <Insets top="22"
                            right="22"
                            bottom="22"
                            left="22"/>
                </padding>

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="4">
                        <Label text="Agenda do Dia"
                               styleClass="section-title"/>

                        <Label text="Visualize os atendimentos organizados por horário."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Atualizar"
                            onAction="#onAtualizarLista"
                            styleClass="btn-ghost"/>
                </HBox>

                <HBox spacing="10"
                      alignment="CENTER_LEFT"
                      styleClass="agenda-action-bar">

                    <Button text="▶ Iniciar Atendimento"
                            onAction="#onIniciarAtendimento"
                            styleClass="btn-primary"/>

                    <Button fx:id="btnFinalizarConsulta"
                            text="✓ Finalizar Atendimento"
                            onAction="#onFinalizarConsulta"
                            styleClass="btn-ghost"/>

                    <Button text="💾 Salvar Agendamento"
                            onAction="#onSalvar"
                            styleClass="btn-primary"/>

                    <Button text="⟳ Atualizar Lista"
                            onAction="#onAtualizarLista"
                            styleClass="btn-ghost"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Fluxo clínico"
                           styleClass="dashboard-badge"/>
                </HBox>

                <TableView fx:id="tbAgenda"
                           VBox.vgrow="ALWAYS"
                           styleClass="table-soft">

                    <columns>
                        <TableColumn fx:id="colHora"
                                     text="Horário"
                                     prefWidth="120"/>

                        <TableColumn fx:id="colProfissional"
                                     text="Profissional"
                                     prefWidth="220"/>

                        <TableColumn fx:id="colSala"
                                     text="Sala"
                                     prefWidth="140"/>

                        <TableColumn fx:id="colPaciente"
                                     text="Paciente"
                                     prefWidth="260"/>

                        <TableColumn fx:id="colStatus"
                                     text="Status"
                                     prefWidth="150"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT"
                      spacing="16">

                    <Label text="Selecione um atendimento para iniciar ou finalizar."
                           styleClass="hint-text"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Agenda clínica"
                           styleClass="dashboard-badge"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>