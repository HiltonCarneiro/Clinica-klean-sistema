<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.clinica.controller.AuditoriaController"
            styleClass="page-root"
            stylesheets="@/styles/app.css">

    <top>
        <VBox spacing="16" styleClass="top-clean">
            <padding>
                <Insets top="22" right="28" bottom="18" left="28"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="5">
                    <Label text="Auditoria do Sistema" styleClass="page-title"/>
                    <Label text="Monitore ações administrativas, alterações sensíveis e rastreabilidade operacional."
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="4">
                    <Label text="Segurança" styleClass="dashboard-badge-admin"/>
                    <Label text="Acesso restrito" styleClass="label-muted"/>
                </VBox>
            </HBox>

            <HBox spacing="18">
                <VBox spacing="8" styleClass="metric-card">
                    <Label text="Rastreabilidade" styleClass="metric-title"/>
                    <Label text="Logs do sistema" styleClass="metric-value"/>
                    <Label text="Acompanhe ações realizadas por usuários."
                           wrapText="true"
                           styleClass="metric-desc"/>
                </VBox>

                <VBox spacing="8" styleClass="metric-card metric-card-admin">
                    <Label text="LGPD" styleClass="metric-title"/>
                    <Label text="Controle" styleClass="metric-value"/>
                    <Label text="Apoio à transparência e segurança clínica."
                           wrapText="true"
                           styleClass="metric-desc"/>
                </VBox>

                <VBox spacing="8" styleClass="metric-card">
                    <Label text="Ações sensíveis" styleClass="metric-title"/>
                    <Label text="Monitoramento" styleClass="metric-value"/>
                    <Label text="Usuários, permissões, financeiro e prontuários."
                           wrapText="true"
                           styleClass="metric-desc"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="0" right="28" bottom="28" left="28"/>
            </padding>

            <VBox spacing="14" styleClass="dashboard-panel">
                <padding>
                    <Insets top="20" right="22" bottom="22" left="22"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4">
                        <Label text="Filtros de auditoria" styleClass="section-title"/>
                        <Label text="Pesquise por usuário, ação, entidade, ID ou detalhes do registro."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Limite:" styleClass="form-label"/>

                    <ComboBox fx:id="cbLimite"
                              prefWidth="120"/>

                    <TextField fx:id="txtFiltro"
                               promptText="Filtrar registros..."
                               prefWidth="360"/>

                    <Button text="Atualizar"
                            onAction="#onAtualizar"
                            styleClass="btn-primary"/>
                </HBox>
            </VBox>

            <VBox spacing="14"
                  VBox.vgrow="ALWAYS"
                  styleClass="dashboard-panel">
                <padding>
                    <Insets top="20" right="22" bottom="22" left="22"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4">
                        <Label text="Trilha de auditoria" styleClass="section-title"/>
                        <Label text="Registros administrativos e operacionais do sistema."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="lblStatus"
                           text="Registros carregados: 0"
                           styleClass="dashboard-badge"/>
                </HBox>

                <TableView fx:id="tblAuditoria"
                           VBox.vgrow="ALWAYS"
                           styleClass="table-soft">
                    <columns>
                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="70"/>

                        <TableColumn fx:id="colDataHora"
                                     text="Data/Hora"
                                     prefWidth="170"/>

                        <TableColumn fx:id="colUsuario"
                                     text="Usuário"
                                     prefWidth="190"/>

                        <TableColumn fx:id="colAcao"
                                     text="Ação"
                                     prefWidth="180"/>

                        <TableColumn fx:id="colEntidade"
                                     text="Entidade"
                                     prefWidth="150"/>

                        <TableColumn fx:id="colEntidadeId"
                                     text="ID Entidade"
                                     prefWidth="120"/>

                        <TableColumn fx:id="colDetalhes"
                                     text="Detalhes"
                                     prefWidth="420"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Dica: use o filtro para encontrar eventos relacionados a financeiro, usuários, permissões, pacientes ou prontuários."
                           styleClass="hint-text"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Auditoria ativa"
                           styleClass="dashboard-badge-admin"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>