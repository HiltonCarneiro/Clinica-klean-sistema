<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.clinica.controller.MainController"
            styleClass="main-root">

    <left>
        <VBox spacing="12"
              prefWidth="250"
              styleClass="sidebar">

            <VBox spacing="4">
                <Label text="Clínica Klean"
                       styleClass="sidebar-title"/>

                <Label text="Gestão Clínica"
                       styleClass="sidebar-sub"/>
            </VBox>

            <Separator/>

            <Button text="⌂ Início"
                    onAction="#onInicio"
                    styleClass="sidebar-btn"/>

            <Button fx:id="btnCardPacientes"
                    text="♣ Pacientes"
                    onAction="#onPacientes"
                    styleClass="sidebar-btn"/>

            <Button fx:id="btnCardAgenda"
                    text="▣ Agenda"
                    onAction="#onAgenda"
                    styleClass="sidebar-btn"/>

            <Button fx:id="btnCardAvaliacaoFisica"
                    text="◈ Avaliação Física"
                    onAction="#onAvaliacaoFisica"
                    styleClass="sidebar-btn"/>

            <Button fx:id="btnCardCaixa"
                    text="▬ Caixa"
                    onAction="#onCaixa"
                    styleClass="sidebar-btn"/>

            <Button fx:id="btnCardEstoque"
                    text="▣ Estoque"
                    onAction="#onEstoque"
                    styleClass="sidebar-btn"/>

            <Button text="||| Relatórios"
                    onAction="#onRelatorios"
                    styleClass="sidebar-btn"/>

            <Button fx:id="btnCardUsuarios"
                    text="♡ Administração"
                    onAction="#onUsuarios"
                    styleClass="sidebar-btn"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="↳ Sair"
                    onAction="#onSair"
                    styleClass="btn-ghost"/>
        </VBox>
    </left>

    <center>

        <BorderPane>

            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="12"
                      styleClass="topbar">

                    <Button fx:id="btnBack"
                            text="←"
                            onAction="#onBack"
                            styleClass="btn-ghost"/>

                    <Button fx:id="btnForward"
                            text="→"
                            onAction="#onForward"
                            styleClass="btn-ghost"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Usuário:"
                           styleClass="label-muted"/>

                    <Label fx:id="lblUsuarioLogado"
                           text="-"
                           styleClass="section-title"/>
                </HBox>
            </top>

            <center>

                <StackPane>

                    <ScrollPane fitToWidth="true"
                                styleClass="dashboard-scroll">

                        <content>

                            <VBox fx:id="homeBox"
                                  spacing="24"
                                  maxWidth="1320"
                                  styleClass="dashboard-root">

                                <padding>
                                    <Insets top="28"
                                            right="32"
                                            bottom="32"
                                            left="32"/>
                                </padding>

                                <HBox alignment="CENTER_LEFT"
                                      spacing="18">

                                    <VBox spacing="6">

                                        <ImageView fx:id="imgLogoHome"
                                                   fitHeight="82"
                                                   preserveRatio="true"
                                                   smooth="true"/>

                                        <Label text="Dashboard"
                                               styleClass="page-title"/>

                                        <Label text="Resumo operacional da Clínica Klean"
                                               styleClass="page-subtitle"/>
                                    </VBox>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <VBox alignment="CENTER_RIGHT"
                                          spacing="4">

                                        <Label text="Ambiente seguro"
                                               styleClass="dashboard-badge"/>

                                        <Label fx:id="lblPerfilUsuario"
                                               text="Perfil"
                                               styleClass="label-muted"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="18">

                                    <VBox spacing="10"
                                          styleClass="metric-card">

                                        <Label text="Agenda de hoje"
                                               styleClass="metric-title"/>

                                        <Label fx:id="lblAgendaHojeValor"
                                               text="-"
                                               styleClass="metric-value"/>

                                        <Label fx:id="lblAgendaHojeSub"
                                               text="-"
                                               wrapText="true"
                                               styleClass="metric-desc"/>
                                    </VBox>

                                    <VBox spacing="10"
                                          styleClass="metric-card">

                                        <Label text="Pacientes ativos"
                                               styleClass="metric-title"/>

                                        <Label fx:id="lblPacientesAtivosValor"
                                               text="-"
                                               styleClass="metric-value"/>

                                        <Label fx:id="lblPacientesAtivosSub"
                                               text="-"
                                               wrapText="true"
                                               styleClass="metric-desc"/>
                                    </VBox>

                                    <VBox fx:id="cardFinanceiroDashboard"
                                          spacing="10"
                                          styleClass="metric-card metric-card-admin">

                                        <Label text="Financeiro"
                                               styleClass="metric-title"/>

                                        <Label fx:id="lblFinanceiroHojeValor"
                                               text="-"
                                               styleClass="metric-value"/>

                                        <Label fx:id="lblFinanceiroHojeSub"
                                               text="-"
                                               wrapText="true"
                                               styleClass="metric-desc"/>
                                    </VBox>

                                    <VBox fx:id="cardEstoqueDashboard"
                                          spacing="10"
                                          styleClass="metric-card">

                                        <Label text="Estoque crítico"
                                               styleClass="metric-title"/>

                                        <Label fx:id="lblEstoqueCriticoValor"
                                               text="-"
                                               styleClass="metric-value"/>

                                        <Label fx:id="lblEstoqueCriticoSub"
                                               text="-"
                                               wrapText="true"
                                               styleClass="metric-desc"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="22"
                                      VBox.vgrow="ALWAYS">

                                    <VBox spacing="14"
                                          styleClass="dashboard-panel"
                                          HBox.hgrow="ALWAYS">

                                        <padding>
                                            <Insets top="22"
                                                    right="22"
                                                    bottom="22"
                                                    left="22"/>
                                        </padding>

                                        <Label text="Ações rápidas"
                                               styleClass="section-title"/>

                                        <TilePane hgap="14"
                                                  vgap="14"
                                                  prefColumns="2">

                                            <Button text="Novo paciente"
                                                    onAction="#onPacientes"
                                                    styleClass="dashboard-action"/>

                                            <Button text="Agenda"
                                                    onAction="#onAgenda"
                                                    styleClass="dashboard-action"/>

                                            <Button fx:id="btnDashboardAvaliacaoFisica"
                                                    text="Avaliação Física"
                                                    onAction="#onAvaliacaoFisica"
                                                    styleClass="dashboard-action"/>

                                            <Button fx:id="btnDashboardCaixa"
                                                    text="Caixa"
                                                    onAction="#onCaixa"
                                                    styleClass="dashboard-action"/>

                                            <Button fx:id="btnDashboardEstoque"
                                                    text="Estoque"
                                                    onAction="#onEstoque"
                                                    styleClass="dashboard-action"/>

                                            <Button fx:id="btnDashboardRelatorios"
                                                    text="Relatórios"
                                                    onAction="#onRelatorios"
                                                    styleClass="dashboard-action"/>

                                            <Button fx:id="btnDashboardUsuarios"
                                                    text="Usuários"
                                                    onAction="#onUsuarios"
                                                    styleClass="dashboard-action"/>
                                        </TilePane>
                                    </VBox>

                                    <VBox spacing="16"
                                          styleClass="dashboard-panel"
                                          HBox.hgrow="ALWAYS">

                                        <padding>
                                            <Insets top="22"
                                                    right="22"
                                                    bottom="22"
                                                    left="22"/>
                                        </padding>

                                        <Label text="Resumo operacional"
                                               styleClass="section-title"/>

                                        <VBox spacing="12">

                                            <Label fx:id="lblResumoAgenda"
                                                   text="-"
                                                   wrapText="true"
                                                   styleClass="activity-text"/>

                                            <Label fx:id="lblResumoPacientes"
                                                   text="-"
                                                   wrapText="true"
                                                   styleClass="activity-text"/>

                                            <Label fx:id="lblResumoEstoque"
                                                   text="-"
                                                   wrapText="true"
                                                   styleClass="activity-text"/>

                                            <Label fx:id="lblResumoFinanceiro"
                                                   text="-"
                                                   wrapText="true"
                                                   styleClass="activity-text"/>
                                        </VBox>
                                    </VBox>
                                </HBox>

                                <VBox fx:id="adminDashboardBox"
                                      spacing="14"
                                      styleClass="dashboard-panel dashboard-admin-panel">

                                    <padding>
                                        <Insets top="22"
                                                right="22"
                                                bottom="22"
                                                left="22"/>
                                    </padding>

                                    <HBox alignment="CENTER_LEFT"
                                          spacing="10">

                                        <VBox spacing="4">

                                            <Label text="Área administrativa"
                                                   styleClass="section-title"/>

                                            <Label text="Indicadores restritos para administradores e gestores autorizados."
                                                   styleClass="page-subtitle"/>
                                        </VBox>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <Label text="ADMIN"
                                               styleClass="dashboard-badge-admin"/>
                                    </HBox>

                                    <HBox spacing="16">

                                        <VBox spacing="8"
                                              styleClass="admin-mini-card">

                                            <Label text="Financeiro"
                                                   styleClass="card-title"/>

                                            <Label text="Acompanhamento financeiro diário da clínica."
                                                   wrapText="true"
                                                   styleClass="card-desc"/>
                                        </VBox>

                                        <VBox spacing="8"
                                              styleClass="admin-mini-card">

                                            <Label text="Relatórios"
                                                   styleClass="card-title"/>

                                            <Label text="Análises gerenciais e operacionais."
                                                   wrapText="true"
                                                   styleClass="card-desc"/>
                                        </VBox>

                                        <VBox spacing="8"
                                              styleClass="admin-mini-card">

                                            <Label text="Auditoria"
                                                   styleClass="card-title"/>

                                            <Label fx:id="lblAuditoriaRecente"
                                                   text="-"
                                                   wrapText="true"
                                                   styleClass="card-desc"/>
                                        </VBox>
                                    </HBox>
                                </VBox>

                            </VBox>

                        </content>

                    </ScrollPane>

                    <AnchorPane fx:id="contentPane"
                                visible="false"
                                managed="false"
                                styleClass="page-root"/>

                </StackPane>

            </center>

        </BorderPane>

    </center>

</BorderPane>