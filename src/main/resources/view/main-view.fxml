<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0"
            prefWidth="1500.0"
            minHeight="760.0"
            minWidth="1200.0"
            styleClass="main-root main-admin-root"
            stylesheets="@../styles/app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.clinica.controller.MainController">

    <top>
        <VBox>
            <MenuBar fx:id="menuBarTop" styleClass="top-menu-bar">
                <menus>
                    <Menu fx:id="menuCadastros" text="Cadastros">
                        <items>
                            <MenuItem fx:id="miPacientes" onAction="#onPacientes" text="Pacientes"/>
                        </items>
                    </Menu>

                    <Menu fx:id="menuOperacoes" text="Operações">
                        <items>
                            <MenuItem fx:id="miAgenda" onAction="#onAgenda" text="Agenda"/>
                            <MenuItem fx:id="miCaixa" onAction="#onCaixa" text="Financeiro"/>
                            <MenuItem fx:id="miEstoque" onAction="#onEstoque" text="Estoque"/>
                            <MenuItem fx:id="miAvaliacaoFisica" onAction="#onAvaliacaoFisica" text="Avaliação Física"/>
                        </items>
                    </Menu>

                    <Menu fx:id="menuRelatorios" text="Relatórios">
                        <items>
                            <MenuItem fx:id="miRelatorios" onAction="#onRelatorios" text="Relatórios"/>
                        </items>
                    </Menu>

                    <Menu fx:id="menuAdministracao" text="Administração">
                        <items>
                            <MenuItem fx:id="miUsuarios" onAction="#onUsuarios" text="Usuários e Perfis"/>
                            <MenuItem fx:id="miAuditoria" onAction="#onAuditoria" text="Auditoria"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <HBox alignment="CENTER_LEFT" spacing="18" styleClass="admin-topbar">
                <padding>
                    <Insets top="14" right="24" bottom="14" left="24"/>
                </padding>

                <Button fx:id="btnBack" onAction="#onBack" text="←" styleClass="admin-top-icon-button"/>
                <Button fx:id="btnForward" onAction="#onForward" text="→" styleClass="admin-top-icon-button"/>
                <Button onAction="#onInicio" text="Início" styleClass="admin-top-home-button"/>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label text="Usuário logado" styleClass="label-topo"/>
                    <Label fx:id="lblUsuarioLogado" styleClass="usuario-topo"/>
                    <Label fx:id="lblPerfilUsuario" styleClass="perfil-topo"/>
                </VBox>

                <Label text="👤" styleClass="admin-user-avatar"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="14"
              prefWidth="270"
              minWidth="260"
              styleClass="admin-sidebar">

            <padding>
                <Insets top="22" right="16" bottom="20" left="16"/>
            </padding>

            <VBox spacing="10" styleClass="admin-sidebar-brand">
                <ImageView fx:id="imgLogoSidebar"
                           fitWidth="160"
                           preserveRatio="true"/>

                <Label text="Clínica Klean" styleClass="admin-sidebar-title"/>
                <Label text="Sistema Integrado de Gestão Clínica" wrapText="true" styleClass="admin-sidebar-subtitle"/>
            </VBox>

            <Label text="MÓDULOS DO SISTEMA"
                   styleClass="sidebar-section-label"/>


            <Button fx:id="btnCardPacientes"
                    maxWidth="Infinity"
                    prefHeight="48"
                    onAction="#onPacientes"
                    styleClass="admin-nav-button"
                    text="👥  Pacientes"/>

            <Button fx:id="btnCardAgenda"
                    maxWidth="Infinity"
                    prefHeight="48"
                    onAction="#onAgenda"
                    styleClass="admin-nav-button"
                    text="📅  Agenda"/>

            <Button fx:id="btnCardCaixa"
                    maxWidth="Infinity"
                    prefHeight="48"
                    onAction="#onCaixa"
                    styleClass="admin-nav-button"
                    text="💰  Caixa"/>

            <Button fx:id="btnCardEstoque"
                    maxWidth="Infinity"
                    prefHeight="48"
                    onAction="#onEstoque"
                    styleClass="admin-nav-button"
                    text="📦  Estoque"/>

            <Button fx:id="btnCardAvaliacaoFisica"
                    maxWidth="Infinity"
                    prefHeight="48"
                    onAction="#onAvaliacaoFisica"
                    styleClass="admin-nav-button"
                    text="🧾  Avaliação Física"/>

            <Button fx:id="btnCardUsuarios"
                    maxWidth="Infinity"
                    prefHeight="48"
                    onAction="#onUsuarios"
                    styleClass="admin-nav-button"
                    text="👤  Usuários e Perfis"/>

            <Separator styleClass="sidebar-separator"/>

            <Button maxWidth="Infinity"
                    prefHeight="48"
                    onAction="#onRelatorios"
                    styleClass="admin-nav-button"
                    text="📊  Relatórios"/>

            <Button maxWidth="Infinity"
                    prefHeight="48"
                    onAction="#onAuditoria"
                    styleClass="admin-nav-button"
                    text="🛡  Auditoria"/>

            <Separator styleClass="sidebar-separator"/>

            <Label text="SISTEMA"
                   styleClass="sidebar-section-label"/>

            <Button maxWidth="Infinity"
                    prefHeight="48"
                    styleClass="admin-nav-button"
                    text="⚙  Configurações"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button maxWidth="Infinity"
                    prefHeight="48"
                    onAction="#onSair"
                    styleClass="admin-exit-button"
                    text="⏻  Sair do Sistema"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="main-content-shell">

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        styleClass="dashboard-scroll">

                <content>
                    <VBox fx:id="homeBox"
                          spacing="22"
                          fillWidth="true"
                          styleClass="admin-dashboard-root">

                        <padding>
                            <Insets top="28" right="34" bottom="34" left="34"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <VBox spacing="6">
                                <Label text="Olá, administrador!" styleClass="page-title"/>
                                <Label text="Confira os principais indicadores para gestão e tomada de decisão da clínica." styleClass="page-subtitle"/>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <VBox alignment="CENTER_RIGHT" spacing="4" styleClass="admin-date-card">
                                <Label text="📅 Hoje" styleClass="dashboard-card-title"/>
                                <Label text="Painel de gestão clínica" styleClass="dashboard-card-sub"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="18">
                            <VBox fx:id="cardFinanceiroDashboard" spacing="12" HBox.hgrow="ALWAYS" styleClass="admin-metric-card">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="💳" styleClass="admin-card-icon green"/>
                                    <VBox spacing="4">
                                        <Label text="Financeiro Hoje" styleClass="dashboard-card-title"/>
                                        <Label fx:id="lblFinanceiroHojeValor" text="R$ 0,00" styleClass="dashboard-card-value green-text"/>
                                    </VBox>
                                </HBox>

                                <Label fx:id="lblFinanceiroHojeSub" text="0 movimentação(ões) hoje" styleClass="dashboard-card-sub"/>
                                <Separator/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Entradas: R$ 0,00 | Saídas: R$ 0,00" styleClass="dashboard-card-sub"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnDashboardCaixa" onAction="#onCaixa" text="→" styleClass="admin-mini-action"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="admin-metric-card">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="📅" styleClass="admin-card-icon blue"/>
                                    <VBox spacing="4">
                                        <Label text="Agenda do Dia" styleClass="dashboard-card-title"/>
                                        <Label fx:id="lblAgendaHojeValor" text="0 agendamento(s)" styleClass="dashboard-card-value"/>
                                    </VBox>
                                </HBox>

                                <Label fx:id="lblAgendaHojeSub" text="Nenhum atendimento pendente hoje" styleClass="dashboard-card-sub"/>
                                <Separator/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Ver agenda completa" styleClass="dashboard-card-sub"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#onAgenda" text="→" styleClass="admin-mini-action"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="admin-metric-card">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="👥" styleClass="admin-card-icon green"/>
                                    <VBox spacing="4">
                                        <Label text="Pacientes Ativos" styleClass="dashboard-card-title"/>
                                        <Label fx:id="lblPacientesAtivosValor" text="0 ativo(s)" styleClass="dashboard-card-value"/>
                                    </VBox>
                                </HBox>

                                <Label fx:id="lblPacientesAtivosSub" text="Pacientes disponíveis para atendimento" styleClass="dashboard-card-sub"/>
                                <Separator/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Ver pacientes" styleClass="dashboard-card-sub"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#onPacientes" text="→" styleClass="admin-mini-action"/>
                                </HBox>
                            </VBox>

                            <VBox fx:id="cardEstoqueDashboard" spacing="12" HBox.hgrow="ALWAYS" styleClass="admin-metric-card">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="📦" styleClass="admin-card-icon orange"/>
                                    <VBox spacing="4">
                                        <Label text="Estoque Crítico" styleClass="dashboard-card-title"/>
                                        <Label fx:id="lblEstoqueCriticoValor" text="0 item(ns)" styleClass="dashboard-card-value"/>
                                    </VBox>
                                </HBox>

                                <Label fx:id="lblEstoqueCriticoSub" text="Nenhum item crítico" styleClass="dashboard-card-sub"/>
                                <Separator/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Ver estoque" styleClass="dashboard-card-sub"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnDashboardEstoque" onAction="#onEstoque" text="→" styleClass="admin-mini-action"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <HBox spacing="18">
                            <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="admin-panel-card">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="🗓" styleClass="admin-card-icon green"/>
                                    <Label text="Próximo Agendamento" styleClass="section-title"/>
                                </HBox>

                                <VBox alignment="CENTER" spacing="8" VBox.vgrow="ALWAYS" styleClass="admin-empty-state">
                                    <Label text="Nenhum agendamento próximo" styleClass="admin-empty-title"/>
                                    <Label text="Você não possui agendamentos futuros nas próximas horas." wrapText="true" styleClass="admin-empty-subtitle"/>
                                </VBox>

                                <Separator/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Ver agenda completa" styleClass="dashboard-card-sub"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#onAgenda" text="→" styleClass="admin-mini-action"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="admin-panel-card">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="○" styleClass="admin-card-icon green"/>
                                    <Label text="Agendamentos do Dia" styleClass="section-title"/>
                                </HBox>

                                <HBox alignment="CENTER" spacing="24">
                                    <StackPane styleClass="admin-circle-indicator">
                                        <VBox alignment="CENTER" spacing="2">
                                            <Label text="0" styleClass="admin-circle-value"/>
                                            <Label text="Total hoje" styleClass="dashboard-card-sub"/>
                                        </VBox>
                                    </StackPane>

                                    <VBox spacing="8">
                                        <Label text="Confirmados        0" styleClass="admin-status-line success"/>
                                        <Label text="Pendentes          0" styleClass="admin-status-line warning"/>
                                        <Label text="Cancelados         0" styleClass="admin-status-line danger"/>
                                        <Label text="Realizados         0" styleClass="admin-status-line blue-text"/>
                                    </VBox>
                                </HBox>

                                <Separator/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Ver todos os agendamentos" styleClass="dashboard-card-sub"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#onAgenda" text="→" styleClass="admin-mini-action"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="admin-panel-card">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="💵" styleClass="admin-card-icon green"/>
                                    <Label text="Financeiro do Mês" styleClass="section-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="↗" styleClass="admin-chart-icon"/>
                                </HBox>

                                <HBox spacing="12">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="admin-finance-box">
                                        <Label text="↑ Entradas" styleClass="admin-status-line success"/>
                                        <Label text="R$ 0,00" styleClass="admin-finance-value green-text"/>
                                    </VBox>

                                    <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="admin-finance-box">
                                        <Label text="↓ Saídas" styleClass="admin-status-line danger"/>
                                        <Label text="R$ 0,00" styleClass="admin-finance-value"/>
                                    </VBox>
                                </HBox>

                                <VBox alignment="CENTER" spacing="3">
                                    <Label text="Saldo" styleClass="dashboard-card-sub"/>
                                    <Label text="R$ 0,00" styleClass="admin-balance-value"/>
                                </VBox>

                                <Separator/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Ver relatório financeiro" styleClass="dashboard-card-sub"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#onCaixa" text="→" styleClass="admin-mini-action"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <HBox spacing="18">
                            <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="admin-panel-card">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="⚠" styleClass="admin-card-icon orange"/>
                                    <Label text="Estoque - Atenção" styleClass="section-title"/>
                                </HBox>

                                <HBox spacing="12">
                                    <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="admin-stock-box">
                                        <Label text="Itens próximos do vencimento" styleClass="admin-status-line warning"/>
                                        <Label text="0" styleClass="dashboard-card-value"/>
                                        <Label text="Nenhum item próximo do vencimento" wrapText="true" styleClass="dashboard-card-sub"/>
                                    </VBox>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="admin-stock-box">
                                        <Label text="Itens com estoque baixo" styleClass="admin-status-line danger"/>
                                        <Label text="0" styleClass="dashboard-card-value"/>
                                        <Label text="Nenhum item com estoque baixo" wrapText="true" styleClass="dashboard-card-sub"/>
                                    </VBox>
                                </HBox>

                                <Separator/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Ver estoque completo" styleClass="dashboard-card-sub"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#onEstoque" text="→" styleClass="admin-mini-action"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="admin-panel-card">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="🛡" styleClass="admin-card-icon green"/>
                                    <Label text="Auditoria Recente" styleClass="section-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnDashboardRelatorios" onAction="#onRelatorios" text="Relatórios" styleClass="admin-small-link"/>
                                </HBox>

                                <Label fx:id="lblAuditoriaRecente" wrapText="true" styleClass="admin-audit-preview"/>

                                <Separator/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Ver auditoria completa" styleClass="dashboard-card-sub"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#onAuditoria" text="→" styleClass="admin-mini-action"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <HBox spacing="18">
                            <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="admin-panel-card admin-modules-panel">
                                <Label text="Atalhos estratégicos" styleClass="section-title"/>
                                <Label text="Acesso rápido aos módulos mais importantes para administração." styleClass="dashboard-card-sub"/>

                                <HBox spacing="12">
                                    <Button fx:id="btnDashboardUsuarios" onAction="#onUsuarios" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="admin-dashboard-shortcut" text="👥 Usuários e Perfis"/>
                                    <Button fx:id="btnDashboardAvaliacaoFisica" onAction="#onAvaliacaoFisica" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="admin-dashboard-shortcut featured" text="🧾 Avaliação Física"/>
                                </HBox>
                            </VBox>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

            <AnchorPane fx:id="contentPane"
                        visible="false"
                        managed="false"
                        prefHeight="9999"
                        prefWidth="9999"/>
        </StackPane>
    </center>

</BorderPane>