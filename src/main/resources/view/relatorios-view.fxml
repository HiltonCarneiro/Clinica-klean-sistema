<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1280"
            prefHeight="800"
            minWidth="1100"
            minHeight="700"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.clinica.controller.UsuariosPerfisController"
            stylesheets="@/styles/app.css"
            styleClass="page-root">

    <top>
        <VBox spacing="16"
              styleClass="top-clean">

            <padding>
                <Insets top="24" right="28" bottom="18" left="28"/>
            </padding>

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="5">

                    <Label text="Usuários &amp; Perfis"
                           styleClass="page-title"/>

                    <Label text="Gerencie acessos, permissões e perfis operacionais da clínica."
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT"
                      spacing="4">

                    <Label text="Administração"
                           styleClass="dashboard-badge-admin"/>

                    <Label text="Controle de acesso"
                           styleClass="label-muted"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>

        <TabPane tabClosingPolicy="UNAVAILABLE"
                 styleClass="modern-tab-pane">

            <tabs>

                <Tab text="Usuários">

                    <BorderPane>

                        <top>
                            <VBox spacing="16"
                                  styleClass="dashboard-panel">

                                <padding>
                                    <Insets top="20" right="22" bottom="20" left="22"/>
                                </padding>

                                <HBox spacing="14"
                                      alignment="CENTER_LEFT">

                                    <VBox spacing="4">

                                        <Label text="Gestão de usuários"
                                               styleClass="section-title"/>

                                        <Label text="Pesquise usuários, cargos e acessos do sistema."
                                               styleClass="page-subtitle"/>
                                    </VBox>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <CheckBox fx:id="chkIncluirInativos"
                                              text="Incluir inativos"/>

                                    <TextField fx:id="txtBuscaUsuario"
                                               promptText="Buscar login, pessoa ou cargo..."
                                               prefWidth="340"/>

                                    <Button text="Atualizar"
                                            onAction="#onAtualizarUsuarios"
                                            styleClass="btn-secondary"/>

                                    <Button text="Backup agora"
                                            onAction="#onFazerBackupAgora"
                                            styleClass="btn-primary"/>
                                </HBox>
                            </VBox>
                        </top>

                        <center>

                            <HBox spacing="18">

                                <padding>
                                    <Insets top="20" right="28" bottom="28" left="28"/>
                                </padding>

                                <VBox spacing="12"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="dashboard-panel">

                                    <padding>
                                        <Insets top="18" right="18" bottom="18" left="18"/>
                                    </padding>

                                    <Label text="Usuários cadastrados"
                                           styleClass="section-title"/>

                                    <TableView fx:id="tblUsuarios"
                                               VBox.vgrow="ALWAYS"
                                               styleClass="table-soft">

                                        <columns>

                                            <TableColumn fx:id="colUId"
                                                         text="ID"
                                                         prefWidth="70"/>

                                            <TableColumn fx:id="colULogin"
                                                         text="Login"
                                                         prefWidth="170"/>

                                            <TableColumn fx:id="colUPessoa"
                                                         text="Pessoa"
                                                         prefWidth="220"/>

                                            <TableColumn fx:id="colUCargo"
                                                         text="Cargo"
                                                         prefWidth="180"/>

                                            <TableColumn fx:id="colUPerfil"
                                                         text="Perfil"
                                                         prefWidth="170"/>

                                            <TableColumn fx:id="colUAtivo"
                                                         text="Ativo"
                                                         prefWidth="90"/>
                                        </columns>
                                    </TableView>

                                    <Label fx:id="lblMsgUsuarios"
                                           styleClass="status-label"/>
                                </VBox>

                                <VBox spacing="16"
                                      prefWidth="420"
                                      styleClass="dashboard-panel">

                                    <padding>
                                        <Insets top="18" right="18" bottom="18" left="18"/>
                                    </padding>

                                    <Label text="Cadastro / edição"
                                           styleClass="section-title"/>

                                    <GridPane hgap="12"
                                              vgap="14">

                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="32"/>
                                            <ColumnConstraints percentWidth="68"/>
                                        </columnConstraints>

                                        <Label text="Cargo:"
                                               GridPane.rowIndex="0"
                                               GridPane.columnIndex="0"
                                               styleClass="form-label"/>

                                        <TextField fx:id="txtCargo"
                                                   GridPane.rowIndex="0"
                                                   GridPane.columnIndex="1"/>

                                        <Label text="Pessoa:"
                                               GridPane.rowIndex="1"
                                               GridPane.columnIndex="0"
                                               styleClass="form-label"/>

                                        <TextField fx:id="txtPessoaNome"
                                                   GridPane.rowIndex="1"
                                                   GridPane.columnIndex="1"/>

                                        <Label text="Login:"
                                               GridPane.rowIndex="2"
                                               GridPane.columnIndex="0"
                                               styleClass="form-label"/>

                                        <TextField fx:id="txtLogin"
                                                   GridPane.rowIndex="2"
                                                   GridPane.columnIndex="1"/>

                                        <Label text="Senha:"
                                               GridPane.rowIndex="3"
                                               GridPane.columnIndex="0"
                                               styleClass="form-label"/>

                                        <PasswordField fx:id="txtSenha"
                                                       GridPane.rowIndex="3"
                                                       GridPane.columnIndex="1"/>

                                        <Label text="Perfil:"
                                               GridPane.rowIndex="4"
                                               GridPane.columnIndex="0"
                                               styleClass="form-label"/>

                                        <ComboBox fx:id="cbPerfilUsuario"
                                                  GridPane.rowIndex="4"
                                                  GridPane.columnIndex="1"/>

                                        <Label text="Ativo:"
                                               GridPane.rowIndex="5"
                                               GridPane.columnIndex="0"
                                               styleClass="form-label"/>

                                        <CheckBox fx:id="chkAtivoUsuario"
                                                  GridPane.rowIndex="5"
                                                  GridPane.columnIndex="1"/>
                                    </GridPane>

                                    <HBox spacing="10">

                                        <Button text="Novo"
                                                onAction="#onNovoUsuario"
                                                styleClass="btn-secondary"/>

                                        <Button text="Salvar"
                                                onAction="#onSalvarUsuario"
                                                styleClass="btn-primary"/>

                                        <Button text="Cancelar"
                                                onAction="#onCancelarUsuario"
                                                styleClass="btn-danger-outline"/>
                                    </HBox>

                                    <HBox spacing="10">

                                        <Button text="Ativar/Inativar"
                                                onAction="#onAtivarInativarUsuario"
                                                styleClass="btn-secondary"/>

                                        <Button text="Resetar senha"
                                                onAction="#onResetarSenha"
                                                styleClass="btn-secondary"/>
                                    </HBox>

                                    <Label fx:id="lblMsgUsuarioForm"
                                           wrapText="true"
                                           styleClass="status-label"/>
                                </VBox>
                            </HBox>
                        </center>
                    </BorderPane>
                </Tab>

                <Tab text="Perfis">

                    <VBox spacing="18">

                        <padding>
                            <Insets top="22" right="28" bottom="28" left="28"/>
                        </padding>

                        <HBox spacing="18">

                            <VBox spacing="12"
                                  prefWidth="420"
                                  styleClass="dashboard-panel">

                                <padding>
                                    <Insets top="18" right="18" bottom="18" left="18"/>
                                </padding>

                                <Label text="Novo perfil"
                                       styleClass="section-title"/>

                                <TextField fx:id="txtNovoPerfil"
                                           promptText="Ex: NUTRICIONISTA"/>

                                <Button text="Criar perfil"
                                        onAction="#onCriarPerfil"
                                        styleClass="btn-primary"/>
                            </VBox>

                            <VBox spacing="12"
                                  HBox.hgrow="ALWAYS"
                                  styleClass="dashboard-panel">

                                <padding>
                                    <Insets top="18" right="18" bottom="18" left="18"/>
                                </padding>

                                <Label text="Perfis cadastrados"
                                       styleClass="section-title"/>

                                <TableView fx:id="tblPerfis"
                                           VBox.vgrow="ALWAYS"
                                           styleClass="table-soft">

                                    <columns>

                                        <TableColumn fx:id="colPId"
                                                     text="ID"
                                                     prefWidth="80"/>

                                        <TableColumn fx:id="colPNome"
                                                     text="Nome"
                                                     prefWidth="420"/>
                                    </columns>
                                </TableView>

                                <HBox spacing="10">

                                    <TextField fx:id="txtRenomearPerfil"
                                               promptText="Novo nome"/>

                                    <Button text="Renomear"
                                            onAction="#onRenomearPerfil"
                                            styleClass="btn-secondary"/>

                                    <Button fx:id="btnExcluirPerfil"
                                            text="Excluir"
                                            onAction="#onExcluirPerfil"
                                            styleClass="btn-danger-outline"/>
                                </HBox>

                                <Label fx:id="lblMsgPerfis"
                                       styleClass="status-label"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </Tab>

                <Tab text="Permissões">

                    <VBox spacing="18">

                        <padding>
                            <Insets top="22" right="28" bottom="28" left="28"/>
                        </padding>

                        <VBox spacing="16"
                              styleClass="dashboard-panel">

                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>

                            <HBox spacing="12"
                                  alignment="CENTER_LEFT">

                                <Label text="Perfil:"
                                       styleClass="form-label"/>

                                <ComboBox fx:id="cbPerfilPermissoes"
                                          prefWidth="280"/>

                                <Button text="Carregar"
                                        onAction="#onCarregarPermissoes"
                                        styleClass="btn-secondary"/>

                                <Button text="Salvar permissões"
                                        onAction="#onSalvarPermissoes"
                                        styleClass="btn-primary"/>
                            </HBox>

                            <ScrollPane fitToWidth="true"
                                        fitToHeight="true"
                                        VBox.vgrow="ALWAYS"
                                        styleClass="scroll-clean">

                                <content>

                                    <VBox fx:id="boxPermissoes"
                                          spacing="10"
                                          styleClass="permissions-box">

                                        <padding>
                                            <Insets top="10"
                                                    right="10"
                                                    bottom="10"
                                                    left="10"/>
                                        </padding>
                                    </VBox>
                                </content>
                            </ScrollPane>

                            <Label fx:id="lblMsgPermissoes"
                                   styleClass="status-label"/>
                        </VBox>
                    </VBox>
                </Tab>

            </tabs>
        </TabPane>
    </center>
</BorderPane>