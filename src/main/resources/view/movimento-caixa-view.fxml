<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.clinica.controller.MovimentoCaixaController"
            styleClass="page-root"
            stylesheets="@/styles/app.css">

    <top>
        <VBox spacing="16" styleClass="top-clean">
            <padding>
                <Insets top="22" right="28" bottom="18" left="28"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="5">
                    <Label text="Movimento de Caixa" styleClass="page-title"/>
                    <Label text="Consulte entradas, saídas, saldo e movimentações financeiras por período."
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="4">
                    <Label text="Financeiro" styleClass="dashboard-badge-admin"/>
                    <Label text="Relatório operacional" styleClass="label-muted"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="0" right="28" bottom="28" left="28"/>
            </padding>

            <HBox spacing="18">
                <VBox spacing="8" styleClass="metric-card">
                    <Label text="Entradas" styleClass="metric-title"/>
                    <Label fx:id="lblEntradas" text="R$ 0,00" styleClass="metric-value finance-positive"/>
                    <Label text="Recebimentos no período" styleClass="metric-desc"/>
                </VBox>

                <VBox spacing="8" styleClass="metric-card">
                    <Label text="Saídas" styleClass="metric-title"/>
                    <Label fx:id="lblSaidas" text="R$ 0,00" styleClass="metric-value finance-negative"/>
                    <Label text="Despesas no período" styleClass="metric-desc"/>
                </VBox>

                <VBox spacing="8" styleClass="metric-card metric-card-admin">
                    <Label text="Saldo" styleClass="metric-title"/>
                    <Label fx:id="lblSaldo" text="R$ 0,00" styleClass="metric-value"/>
                    <Label text="Resultado do período selecionado" styleClass="metric-desc"/>
                </VBox>
            </HBox>

            <VBox spacing="14" styleClass="dashboard-panel">
                <padding>
                    <Insets top="20" right="22" bottom="22" left="22"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Filtros" styleClass="section-title"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Início:" styleClass="form-label"/>
                    <DatePicker fx:id="dtInicio"/>

                    <Label text="Fim:" styleClass="form-label"/>
                    <DatePicker fx:id="dtFim"/>

                    <Button fx:id="btnBuscar"
                            text="Buscar"
                            onAction="#onBuscar"
                            styleClass="btn-primary"/>

                    <Button fx:id="btnFechar"
                            text="Fechar"
                            onAction="#onFechar"
                            styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="14" VBox.vgrow="ALWAYS" styleClass="dashboard-panel">
                <padding>
                    <Insets top="20" right="22" bottom="22" left="22"/>
                </padding>

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="Movimentações" styleClass="section-title"/>
                        <Label text="Listagem financeira detalhada do período selecionado."
                               styleClass="page-subtitle"/>
                    </VBox>
                </HBox>

                <TableView fx:id="tblMovimentos"
                           VBox.vgrow="ALWAYS"
                           styleClass="table-soft">
                    <columns>
                        <TableColumn fx:id="colData" text="Data" prefWidth="130"/>
                        <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="320"/>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120"/>
                        <TableColumn fx:id="colValor" text="Valor" prefWidth="140"/>
                        <TableColumn fx:id="colFormaPagamento" text="Pagamento" prefWidth="150"/>
                        <TableColumn fx:id="colPaciente" text="Paciente" prefWidth="240"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>