<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.clinica.controller.PacienteController"
            styleClass="page-root"
            stylesheets="@/styles/app.css">

    <center>
        <StackPane>

            <!-- TELA INICIAL -->
            <VBox fx:id="boxEscolha"
                  spacing="24"
                  styleClass="paciente-home-root">

                <padding>
                    <Insets top="34" right="42" bottom="36" left="42"/>
                </padding>

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="paciente-hero">

                    <Label text="P"
                           alignment="CENTER"
                           styleClass="paciente-hero-icon"/>

                    <VBox spacing="5">
                        <Label text="Pacientes" styleClass="page-title"/>
                        <Label text="Gerencie cadastros, buscas, histórico clínico e acompanhamento dos pacientes."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="+ Novo paciente"
                            onAction="#irParaCadastro"
                            styleClass="btn-primary"/>

                    <Button text="Buscar paciente"
                            onAction="#irParaBusca"
                            styleClass="btn-ghost"/>
                </HBox>

                <!-- INDICADORES -->
                <HBox spacing="18" alignment="CENTER">

                    <VBox spacing="8" styleClass="paciente-metric-card" HBox.hgrow="ALWAYS">
                        <Label text="Pacientes ativos" styleClass="metric-title"/>
                        <Label text="Gestão clínica" styleClass="metric-value"/>
                        <Label text="Acesse, edite e acompanhe dados cadastrais." styleClass="metric-desc" wrapText="true"/>
                    </VBox>

                    <VBox spacing="8" styleClass="paciente-metric-card" HBox.hgrow="ALWAYS">
                        <Label text="Histórico clínico" styleClass="metric-title"/>
                        <Label text="Prontuário" styleClass="metric-value"/>
                        <Label text="Consulte evoluções, registros e atendimentos anteriores." styleClass="metric-desc" wrapText="true"/>
                    </VBox>

                    <VBox spacing="8" styleClass="paciente-metric-card" HBox.hgrow="ALWAYS">
                        <Label text="Busca rápida" styleClass="metric-title"/>
                        <Label text="Localização" styleClass="metric-value"/>
                        <Label text="Encontre pacientes por nome, CPF, RG ou telefone." styleClass="metric-desc" wrapText="true"/>
                    </VBox>

                    <VBox spacing="8" styleClass="paciente-metric-card paciente-metric-card-highlight" HBox.hgrow="ALWAYS">
                        <Label text="Área segura" styleClass="metric-title"/>
                        <Label text="Controle" styleClass="metric-value"/>
                        <Label text="Dados organizados para uma rotina clínica confiável." styleClass="metric-desc" wrapText="true"/>
                    </VBox>

                </HBox>

                <!-- AÇÕES PRINCIPAIS -->
                <HBox spacing="22" alignment="CENTER">

                    <VBox spacing="16" styleClass="paciente-action-card" HBox.hgrow="ALWAYS">
                        <Label text="Novo paciente" styleClass="paciente-action-title"/>
                        <Label text="Cadastre dados pessoais, documentos, contato, endereço e responsável legal quando necessário."
                               wrapText="true"
                               styleClass="paciente-action-desc"/>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button text="Cadastrar paciente"
                                onAction="#irParaCadastro"
                                maxWidth="1.7976931348623157E308"
                                styleClass="btn-primary"/>
                    </VBox>

                    <VBox spacing="16" styleClass="paciente-action-card" HBox.hgrow="ALWAYS">
                        <Label text="Buscar paciente" styleClass="paciente-action-title"/>
                        <Label text="Localize registros existentes, edite informações cadastrais e acesse o histórico clínico."
                               wrapText="true"
                               styleClass="paciente-action-desc"/>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button text="Ir para busca"
                                onAction="#irParaBusca"
                                maxWidth="1.7976931348623157E308"
                                styleClass="btn-primary"/>
                    </VBox>

                    <VBox spacing="16" styleClass="paciente-info-panel" HBox.hgrow="ALWAYS">
                        <Label text="Rotina recomendada" styleClass="paciente-action-title"/>

                        <Label text="• Antes de cadastrar, verifique se o paciente já existe no sistema."
                               wrapText="true"
                               styleClass="hint-text"/>

                        <Label text="• Mantenha telefone, CPF e data de nascimento sempre atualizados."
                               wrapText="true"
                               styleClass="hint-text"/>

                        <Label text="• Use o histórico clínico para acompanhar atendimentos anteriores."
                               wrapText="true"
                               styleClass="hint-text"/>
                    </VBox>

                </HBox>

            </VBox>

            <!-- CADASTRO -->
            <ScrollPane fx:id="scrollCadastro"
                        fitToWidth="true"
                        visible="false"
                        managed="false"
                        styleClass="page-scroll">

                <content>
                    <StackPane styleClass="page-center">

                        <VBox spacing="20" styleClass="page-content">

                            <padding>
                                <Insets top="26" right="30" bottom="30" left="30"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="12">

                                <Button text="← Voltar"
                                        onAction="#voltarEscolha"
                                        styleClass="btn-ghost"/>

                                <VBox spacing="4">
                                    <Label text="Cadastro de Paciente" styleClass="page-title"/>
                                    <Label text="Preencha os dados principais do paciente com atenção."
                                           styleClass="page-subtitle"/>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button text="Novo"
                                        onAction="#onNovo"
                                        styleClass="btn-ghost"/>

                                <Button text="Salvar"
                                        onAction="#onSalvar"
                                        styleClass="btn-primary"/>
                            </HBox>

                            <!-- DADOS PESSOAIS -->
                            <VBox spacing="14" styleClass="dashboard-panel">
                                <padding>
                                    <Insets top="22" right="24" bottom="24" left="24"/>
                                </padding>

                                <Label text="Dados pessoais" styleClass="section-title"/>

                                <GridPane hgap="16" vgap="14">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="135"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="135"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <Label text="Nome:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtNome"
                                               promptText="Nome completo"
                                               maxWidth="1.7976931348623157E308"
                                               GridPane.rowIndex="0"
                                               GridPane.columnIndex="1"
                                               GridPane.columnSpan="3"/>

                                    <Label text="CPF:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtCpf"
                                               promptText="000.000.000-00"
                                               GridPane.rowIndex="1"
                                               GridPane.columnIndex="1"/>

                                    <Label text="RG:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                    <TextField fx:id="txtRg"
                                               promptText="0.000.000"
                                               GridPane.rowIndex="1"
                                               GridPane.columnIndex="3"/>

                                    <Label text="Data nascimento:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <DatePicker fx:id="dpDataNascimento"
                                                GridPane.rowIndex="2"
                                                GridPane.columnIndex="1"/>

                                    <Label text="Idade:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                                    <TextField fx:id="txtIdade"
                                               editable="false"
                                               focusTraversable="false"
                                               promptText="Calculada automaticamente"
                                               GridPane.rowIndex="2"
                                               GridPane.columnIndex="3"/>

                                    <Label text="Telefone:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtTelefone"
                                               promptText="(00) 00000-0000"
                                               GridPane.rowIndex="3"
                                               GridPane.columnIndex="1"/>

                                    <Label text="Responsável legal:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                                    <TextField fx:id="txtResponsavelLegal"
                                               promptText="Quando aplicável"
                                               GridPane.rowIndex="3"
                                               GridPane.columnIndex="3"/>
                                </GridPane>
                            </VBox>

                            <!-- ENDEREÇO -->
                            <VBox spacing="14" styleClass="dashboard-panel">
                                <padding>
                                    <Insets top="22" right="24" bottom="24" left="24"/>
                                </padding>

                                <Label text="Endereço" styleClass="section-title"/>

                                <GridPane hgap="16" vgap="14">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="135"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints minWidth="135"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <Label text="CEP:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtCep"
                                               promptText="00000-000"
                                               GridPane.rowIndex="0"
                                               GridPane.columnIndex="1"/>

                                    <Label text="UF:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                    <TextField fx:id="txtUf"
                                               promptText="UF"
                                               GridPane.rowIndex="0"
                                               GridPane.columnIndex="3"/>

                                    <Label text="Rua:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtRua"
                                               promptText="Rua, avenida ou logradouro"
                                               maxWidth="1.7976931348623157E308"
                                               GridPane.rowIndex="1"
                                               GridPane.columnIndex="1"
                                               GridPane.columnSpan="3"/>

                                    <Label text="Número:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtNumero"
                                               promptText="Número"
                                               GridPane.rowIndex="2"
                                               GridPane.columnIndex="1"/>

                                    <CheckBox fx:id="chkSemNumero"
                                              text="Sem número"
                                              GridPane.rowIndex="2"
                                              GridPane.columnIndex="2"
                                              GridPane.columnSpan="2"/>

                                    <Label text="Complemento:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtComplemento"
                                               promptText="Apartamento, bloco, referência..."
                                               maxWidth="1.7976931348623157E308"
                                               GridPane.rowIndex="3"
                                               GridPane.columnIndex="1"
                                               GridPane.columnSpan="3"/>

                                    <Label text="Bairro:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtBairro"
                                               promptText="Bairro"
                                               GridPane.rowIndex="4"
                                               GridPane.columnIndex="1"/>

                                    <Label text="Cidade:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                                    <TextField fx:id="txtCidade"
                                               promptText="Cidade"
                                               GridPane.rowIndex="4"
                                               GridPane.columnIndex="3"/>
                                </GridPane>
                            </VBox>

                            <!-- STATUS / AÇÕES -->
                            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="dashboard-panel">
                                <padding>
                                    <Insets top="18" right="20" bottom="18" left="20"/>
                                </padding>

                                <Button fx:id="btnInativar"
                                        text="Inativar paciente"
                                        onAction="#onInativar"
                                        styleClass="btn-ghost"/>

                                <Button fx:id="btnAtivar"
                                        text="Ativar paciente"
                                        onAction="#onAtivar"
                                        styleClass="btn-primary"/>

                                <CheckBox fx:id="chkMostrarInativos"
                                          text="Mostrar inativos"
                                          onAction="#onAtualizarLista"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label fx:id="lblMensagem"
                                       wrapText="true"
                                       styleClass="hint-text"/>
                            </HBox>

                        </VBox>
                    </StackPane>
                </content>
            </ScrollPane>

            <!-- BUSCA -->
            <VBox fx:id="boxBusca"
                  spacing="18"
                  visible="false"
                  managed="false"
                  styleClass="page-content">

                <padding>
                    <Insets top="26" right="30" bottom="30" left="30"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">

                    <Button text="← Voltar"
                            onAction="#voltarEscolha"
                            styleClass="btn-ghost"/>

                    <VBox spacing="4">
                        <Label text="Busca de Pacientes" styleClass="page-title"/>
                        <Label text="Localize pacientes por nome, CPF, telefone ou RG."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnEditarSelecionado"
                            text="Editar"
                            onAction="#onEditarSelecionado"
                            disable="true"
                            styleClass="btn-ghost"/>

                    <Button fx:id="btnHistoricoSelecionado"
                            text="Ver histórico"
                            onAction="#onVerHistoricoSelecionado"
                            disable="true"
                            styleClass="btn-primary"/>
                </HBox>

                <VBox spacing="14" styleClass="dashboard-panel">
                    <padding>
                        <Insets top="18" right="20" bottom="20" left="20"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="10">

                        <TextField fx:id="txtBusca"
                                   promptText="Digite nome, CPF, RG ou telefone..."
                                   HBox.hgrow="ALWAYS"
                                   maxWidth="1.7976931348623157E308"/>

                        <Button text="Buscar"
                                onAction="#onBuscarPaciente"
                                styleClass="btn-primary"/>

                        <Button text="Limpar"
                                onAction="#onLimparBusca"
                                styleClass="btn-ghost"/>
                    </HBox>

                    <CheckBox fx:id="chkMostrarInativosBusca"
                              text="Mostrar pacientes inativos"
                              onAction="#onBuscarPaciente"/>
                </VBox>

                <TableView fx:id="tableBusca"
                           VBox.vgrow="ALWAYS"
                           styleClass="table-soft">

                    <columns>
                        <TableColumn fx:id="colBuscaNome"
                                     text="Nome"
                                     prefWidth="320"/>

                        <TableColumn fx:id="colBuscaCpf"
                                     text="CPF / RG"
                                     prefWidth="180"/>

                        <TableColumn fx:id="colBuscaTelefone"
                                     text="Telefone"
                                     prefWidth="160"/>

                        <TableColumn fx:id="colBuscaDataNascimento"
                                     text="Data nasc."
                                     prefWidth="140"/>

                        <TableColumn fx:id="colBuscaAtivo"
                                     text="Status"
                                     prefWidth="110"/>
                    </columns>
                </TableView>

            </VBox>

        </StackPane>
    </center>
</BorderPane>