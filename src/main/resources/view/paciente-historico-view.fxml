<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.clinica.controller.PacienteHistoricoController"
            styleClass="page-clean"
            stylesheets="@/styles/app.css">

    <top>
        <VBox spacing="16" styleClass="top-clean">
            <padding>
                <Insets top="22" right="26" bottom="18" left="26"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4">
                    <Label text="Histórico do Paciente"
                           styleClass="page-title"/>

                    <Label text="Resumo clínico, anexos, exames, anamneses, avaliações físicas e evoluções do paciente."
                           styleClass="page-subtitle"/>
                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="Fechar"
                        onAction="#onFechar"
                        styleClass="btn-ghost"/>
            </HBox>

            <VBox spacing="14" styleClass="card">
                <padding>
                    <Insets top="18" right="20" bottom="20" left="20"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="2">
                        <Label fx:id="lblNome"
                               text="-"
                               styleClass="header-title"/>

                        <HBox spacing="12">
                            <Label text="CPF:" styleClass="label-muted"/>
                            <Label fx:id="lblCpf" text="-"/>

                            <Label text="RG:" styleClass="label-muted"/>
                            <Label fx:id="lblRg" text="-"/>

                            <Label text="Ativo:" styleClass="label-muted"/>
                            <Label fx:id="lblAtivo" text="-"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator/>

                <GridPane hgap="14" vgap="8" styleClass="info-grid">
                    <columnConstraints>
                        <ColumnConstraints minWidth="125" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="125" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Telefone:" styleClass="label-muted" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblTelefone" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Data nasc.:" styleClass="label-muted" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Label fx:id="lblDataNascimento" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="Idade:" styleClass="label-muted" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lblIdade" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Endereço:" styleClass="label-muted" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="lblEndereco"
                           text="-"
                           wrapText="true"
                           maxWidth="1.7976931348623157E308"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"
                           GridPane.columnSpan="3"/>
                </GridPane>
            </VBox>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE"
                 styleClass="tabs-clean">

            <Tab text="Anexos / Exames">
                <VBox spacing="14" styleClass="tab-body">
                    <padding>
                        <Insets top="18" right="26" bottom="24" left="26"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox spacing="2">
                            <Label text="Anexos do paciente"
                                   styleClass="section-title"/>

                            <Label text="Documentos, exames e arquivos vinculados ao paciente."
                                   styleClass="hint-text"/>
                        </VBox>

                        <Pane HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnAtualizarAnexos"
                                text="Atualizar"
                                onAction="#onAtualizarAnexos"
                                styleClass="btn-ghost"/>

                        <Button fx:id="btnAbrirAnexo"
                                text="Abrir"
                                onAction="#onAbrirAnexo"
                                disable="true"
                                styleClass="btn-primary"/>
                    </HBox>

                    <TableView fx:id="tableAnexos"
                               VBox.vgrow="ALWAYS"
                               styleClass="table-soft">
                        <columns>
                            <TableColumn fx:id="colAnexoNome" text="Arquivo" prefWidth="360"/>
                            <TableColumn fx:id="colAnexoDescricao" text="Descrição" prefWidth="320"/>
                            <TableColumn fx:id="colAnexoDataHora" text="Data/Hora" prefWidth="180"/>
                        </columns>
                    </TableView>

                    <Label text="Dica: selecione um anexo e clique em “Abrir” para visualizar o arquivo."
                           styleClass="hint-text"/>
                </VBox>
            </Tab>

            <Tab text="Anamnese &amp; Evoluções">
                <BorderPane styleClass="tab-body">
                    <padding>
                        <Insets top="18" right="26" bottom="24" left="26"/>
                    </padding>

                    <top>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="2">
                                <Label text="Histórico de Anamnese e Evoluções"
                                       styleClass="section-title"/>

                                <Label text="Selecione um registro para visualizar o resumo clínico detalhado."
                                       styleClass="hint-text"/>
                            </VBox>

                            <Pane HBox.hgrow="ALWAYS"/>

                            <Button fx:id="btnAtualizarAnamnese"
                                    text="Atualizar"
                                    onAction="#onAtualizarAnamnese"
                                    styleClass="btn-ghost"/>
                        </HBox>
                    </top>

                    <left>
                        <VBox spacing="10" prefWidth="380">
                            <padding>
                                <Insets top="14" right="18" bottom="0" left="0"/>
                            </padding>

                            <TableView fx:id="tableAnamnese"
                                       VBox.vgrow="ALWAYS"
                                       styleClass="table-soft">
                                <columns>
                                    <TableColumn fx:id="colAnaDataHora" text="Data/Hora" prefWidth="190"/>
                                    <TableColumn fx:id="colAnaTipo" text="Tipo" prefWidth="170"/>
                                </columns>
                            </TableView>

                            <Label text="Os detalhes aparecem ao lado após selecionar um item."
                                   styleClass="hint-text"/>
                        </VBox>
                    </left>

                    <center>
                        <VBox spacing="14">
                            <padding>
                                <Insets top="14" right="0" bottom="0" left="0"/>
                            </padding>

                            <VBox spacing="8" styleClass="card">
                                <padding>
                                    <Insets top="16" right="18" bottom="18" left="18"/>
                                </padding>

                                <Label text="Observações do registro"
                                       styleClass="field-title"/>

                                <TextArea fx:id="txtObservacoes"
                                          prefRowCount="4"
                                          wrapText="true"
                                          editable="false"
                                          promptText="Nenhuma observação registrada."
                                          styleClass="area-clean"/>
                            </VBox>

                            <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
                                <padding>
                                    <Insets top="16" right="18" bottom="18" left="18"/>
                                </padding>

                                <Label text="Resumo clínico"
                                       styleClass="field-title"/>

                                <TextArea fx:id="txtResumo"
                                          prefRowCount="18"
                                          wrapText="true"
                                          editable="false"
                                          VBox.vgrow="ALWAYS"
                                          promptText="Selecione um registro para visualizar o resumo clínico."
                                          styleClass="area-clean"/>
                            </VBox>
                        </VBox>
                    </center>
                </BorderPane>
            </Tab>

            <Tab text="Avaliação Física">
                <BorderPane styleClass="tab-body">
                    <padding>
                        <Insets top="18" right="26" bottom="24" left="26"/>
                    </padding>

                    <top>
                        <VBox spacing="16">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <VBox spacing="2">
                                    <Label text="Histórico de Avaliações Físicas"
                                           styleClass="section-title"/>

                                    <Label text="Acompanhe evolução de peso, IMC, composição corporal, RCQ e observações do profissional."
                                           styleClass="hint-text"/>
                                </VBox>

                                <Pane HBox.hgrow="ALWAYS"/>

                                <Button fx:id="btnAtualizarAvaliacoesFisicas"
                                        text="Atualizar"
                                        onAction="#onAtualizarAvaliacoesFisicas"
                                        styleClass="btn-ghost"/>
                            </HBox>

                            <GridPane hgap="12" vgap="12">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="14"/>
                                    <ColumnConstraints percentWidth="14"/>
                                    <ColumnConstraints percentWidth="14"/>
                                    <ColumnConstraints percentWidth="14"/>
                                    <ColumnConstraints percentWidth="14"/>
                                    <ColumnConstraints percentWidth="15"/>
                                    <ColumnConstraints percentWidth="15"/>
                                </columnConstraints>

                                <VBox spacing="5" styleClass="metric-card" GridPane.columnIndex="0">
                                    <Label text="Última avaliação" styleClass="metric-title"/>
                                    <Label fx:id="lblAfUltimaData" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.columnIndex="1">
                                    <Label text="Peso" styleClass="metric-title"/>
                                    <Label fx:id="lblAfUltimoPeso" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.columnIndex="2">
                                    <Label text="IMC" styleClass="metric-title"/>
                                    <Label fx:id="lblAfUltimoImc" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.columnIndex="3">
                                    <Label text="\% Gordura" styleClass="metric-title"/>
                                    <Label fx:id="lblAfUltimaGordura" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.columnIndex="4">
                                    <Label text="Massa magra" styleClass="metric-title"/>
                                    <Label fx:id="lblAfUltimaMassaMagra" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.columnIndex="5">
                                    <Label text="Massa gorda" styleClass="metric-title"/>
                                    <Label fx:id="lblAfUltimaMassaGorda" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.columnIndex="6">
                                    <Label text="RCQ" styleClass="metric-title"/>
                                    <Label fx:id="lblAfUltimoRcq" text="-" styleClass="metric-value"/>
                                </VBox>
                            </GridPane>
                        </VBox>
                    </top>

                    <center>
                        <SplitPane dividerPositions="0.55">
                            <VBox spacing="10">
                                <padding>
                                    <Insets top="16" right="14" bottom="0" left="0"/>
                                </padding>

                                <TableView fx:id="tableAvaliacoesFisicas"
                                           VBox.vgrow="ALWAYS"
                                           styleClass="table-soft">
                                    <columns>
                                        <TableColumn fx:id="colAfData" text="Data" prefWidth="110"/>
                                        <TableColumn fx:id="colAfProfissional" text="Profissional" prefWidth="190"/>
                                        <TableColumn fx:id="colAfPeso" text="Peso" prefWidth="80"/>
                                        <TableColumn fx:id="colAfImc" text="IMC" prefWidth="80"/>
                                        <TableColumn fx:id="colAfGordura" text="\% Gordura" prefWidth="110"/>
                                        <TableColumn fx:id="colAfMassaMagra" text="Massa magra" prefWidth="120"/>
                                        <TableColumn fx:id="colAfMassaGorda" text="Massa gorda" prefWidth="120"/>
                                        <TableColumn fx:id="colAfRcq" text="RCQ" prefWidth="80"/>
                                    </columns>
                                </TableView>

                                <Label text="Selecione uma avaliação para visualizar o resumo completo."
                                       styleClass="hint-text"/>
                            </VBox>

                            <VBox spacing="10">
                                <padding>
                                    <Insets top="16" right="0" bottom="0" left="14"/>
                                </padding>

                                <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
                                    <padding>
                                        <Insets top="16" right="18" bottom="18" left="18"/>
                                    </padding>

                                    <Label text="Resumo da avaliação física"
                                           styleClass="field-title"/>

                                    <TextArea fx:id="txtResumoAvaliacaoFisica"
                                              prefRowCount="22"
                                              wrapText="true"
                                              editable="false"
                                              VBox.vgrow="ALWAYS"
                                              promptText="Selecione uma avaliação para visualizar os detalhes."
                                              styleClass="area-clean"/>
                                </VBox>
                            </VBox>
                        </SplitPane>
                    </center>
                </BorderPane>
            </Tab>

        </TabPane>
    </center>

</BorderPane>