<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.com.clinica.controller.LoginController"
           styleClass="login-root login-premium-root">

    <VBox alignment="CENTER"
          maxWidth="1120"
          maxHeight="660"
          styleClass="login-premium-shell">

        <HBox HBox.hgrow="ALWAYS"
              VBox.vgrow="ALWAYS">

            <VBox spacing="22"
                  alignment="CENTER_LEFT"
                  prefWidth="500"
                  styleClass="login-premium-brand-panel">

                <ImageView fx:id="imgLogoLogin"
                           fitWidth="230"
                           preserveRatio="true"
                           smooth="true"/>

                <VBox spacing="8">
                    <Label text="Clínica Klean"
                           styleClass="login-premium-brand-title"/>

                    <Label text="Saúde Integrativa"
                           styleClass="login-premium-brand-subtitle"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="8" styleClass="login-premium-mini-card">
                    <Label text="Sistema de gestão clínica"
                           styleClass="login-premium-mini-title"/>

                    <Label text="Acesso seguro ao ambiente administrativo da clínica."
                           wrapText="true"
                           styleClass="login-premium-mini-subtitle"/>
                </VBox>
            </VBox>

            <VBox spacing="26"
                  alignment="CENTER"
                  HBox.hgrow="ALWAYS"
                  styleClass="login-premium-form-panel">

                <VBox spacing="8" alignment="CENTER">
                    <Label text="Bem-vindo"
                           styleClass="login-premium-title"/>

                    <Label text="Entre para acessar o sistema da clínica"
                           styleClass="login-premium-subtitle"/>
                </VBox>

                <VBox spacing="16" maxWidth="390">

                    <VBox spacing="7">
                        <Label text="Usuário"
                               styleClass="login-label"/>

                        <TextField fx:id="txtUsuario"
                                   promptText="Digite seu usuário"
                                   prefHeight="48"
                                   styleClass="login-field login-premium-field"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="Senha"
                               styleClass="login-label"/>

                        <HBox spacing="10">
                            <PasswordField fx:id="txtSenha"
                                           promptText="Digite sua senha"
                                           prefHeight="48"
                                           HBox.hgrow="ALWAYS"
                                           styleClass="login-field login-premium-field"/>

                            <TextField fx:id="txtSenhaVisivel"
                                       promptText="Digite sua senha"
                                       prefHeight="48"
                                       visible="false"
                                       managed="false"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="login-field login-premium-field"/>

                            <Button fx:id="btnToggleSenha"
                                    text="👁"
                                    onAction="#onToggleSenha"
                                    prefWidth="54"
                                    prefHeight="48"
                                    styleClass="login-premium-eye"/>
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER_LEFT">
                        <CheckBox fx:id="chkLembrarUsuario"
                                  text="Lembrar usuário"
                                  styleClass="login-premium-check"/>

                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <Label fx:id="lblErro"
                           wrapText="true"
                           styleClass="login-error"/>

                    <Button text="Entrar no sistema"
                            onAction="#onEntrar"
                            defaultButton="true"
                            maxWidth="Infinity"
                            prefHeight="50"
                            styleClass="login-button login-premium-button"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

</StackPane>