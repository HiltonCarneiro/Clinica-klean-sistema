<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.com.clinica.controller.LoginController"
           styleClass="login-root">

    <HBox maxWidth="1180"
          maxHeight="680"
          styleClass="login-shell">

        <VBox spacing="18"
              alignment="CENTER_LEFT"
              prefWidth="520"
              styleClass="login-left">

            <ImageView fx:id="imgLogoLogin"
                       fitHeight="120"
                       preserveRatio="true"
                       smooth="true"/>

            <Label text="Clínica Klean"
                   styleClass="login-brand"/>

            <Label text="Sistema profissional para gestão clínica moderna, segura e intuitiva."
                   wrapText="true"
                   styleClass="login-brand-sub"/>

        </VBox>

        <VBox spacing="22"
              alignment="CENTER"
              HBox.hgrow="ALWAYS"
              styleClass="login-right">

            <VBox spacing="6" alignment="CENTER">
                <Label text="Bem-vindo"
                       styleClass="login-title"/>

                <Label text="Entre com suas credenciais para acessar o sistema"
                       styleClass="page-subtitle"/>
            </VBox>

            <VBox spacing="14" maxWidth="360">

                <VBox spacing="6">
                    <Label text="Usuário"
                           styleClass="login-label"/>

                    <TextField fx:id="txtUsuario"
                               styleClass="login-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Senha"
                           styleClass="login-label"/>

                    <HBox spacing="10">

                        <PasswordField fx:id="txtSenha"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="login-field"/>

                        <TextField fx:id="txtSenhaVisivel"
                                   visible="false"
                                   managed="false"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="login-field"/>

                        <Button fx:id="btnToggleSenha"
                                text="👁"
                                onAction="#onToggleSenha"
                                styleClass="login-eye"/>
                    </HBox>
                </VBox>

                <CheckBox fx:id="chkLembrarUsuario"
                          text="Lembrar usuário"/>

                <Label fx:id="lblErro"
                       styleClass="login-error"/>

                <Button text="Entrar"
                        onAction="#onEntrar"
                        defaultButton="true"
                        maxWidth="999"
                        styleClass="login-button"/>
            </VBox>

        </VBox>

    </HBox>

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

</StackPane>